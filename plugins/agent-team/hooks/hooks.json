{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/session_start.py\"",
            "timeout": 5,
            "statusMessage": "Loading Agent Team entrypoint",
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
